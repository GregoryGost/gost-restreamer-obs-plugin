{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 — разработка",
      "description": "MSVC v143, Windows SDK 10.0.26100.0, OBS 33.0.1 и Qt 6.11.1",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64,version=10.0.26100.0",
      "toolset": "v143",
      "binaryDir": "${sourceDir}/build_x64",
      "environment": {
        "TEMP": "${sourceDir}/build/tmp",
        "TMP": "${sourceDir}/build/tmp"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "ENABLE_FRONTEND_API": true,
        "ENABLE_QT": true,
        "BUILD_TESTING": true,
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install",
        "CMAKE_PREFIX_PATH": "${sourceDir}/.deps/obs-deps-2026-10-23-x64;${sourceDir}/.deps/obs-deps-qt6-2026-10-23-x64;${sourceDir}/.deps"
      }
    },
    {
      "name": "windows-ci-x64",
      "inherits": "windows-x64",
      "displayName": "Windows x64 — CI",
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-ci-x64",
      "configurePreset": "windows-ci-x64",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "RelWithDebInfo",
      "environment": {
        "GOST_TEST_BACKEND_URL": "http://192.168.88.8:8080"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "environment": {
        "GOST_TEST_BACKEND_URL": "http://192.168.88.8:8080"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x64-offline",
      "configurePreset": "windows-x64",
      "configuration": "RelWithDebInfo",
      "environment": {
        "GOST_TEST_BACKEND_URL": ""
      },
      "filter": {
        "exclude": {
          "label": "backend"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
